# OpenAlex API Configuration
OPENALEX_API_KEY=your_api_key_here
OPENALEX_EMAIL=your_email@example.com

# Get your free API key at: https://openalex.org/users
# Daily credit limit depends on your plan

# Semantic Scholar API Configuration
S2_API_KEY=your_s2_api_key_here
# Get your free API key at: https://www.semanticscholar.org/product/api#api-key
# Rate limit: 1 request per second (cumulative across all endpoints)

# CrossRef API Configuration
CROSSREF_EMAIL=your_email@example.com
# No API key needed - email enables "polite pool" for better reliability
# Rate limit: 50 req/sec (we use 10 req/sec to be safe)

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                       # optional, for Qdrant Cloud
