# OpenAlex API Configuration
OPENALEX_API_KEYS=your_api_key_here
OPENALEX_EMAIL=your_email@example.com

# Get your free API key at: https://openalex.org/users
# Daily credit limit depends on your plan
# Note: from_updated_date (incremental collection) requires a Premium plan.
# Without Premium, the system falls back to publication_year filtering.

# Semantic Scholar API (comma-separated for multi-key round-robin rotation)
# Replaces the legacy S2_API_KEY (singular, still supported as fallback)
S2_API_KEYS=your_s2_key_1,your_s2_key_2
# Get your free API key at: https://www.semanticscholar.org/product/api#api-key
# Rate limit: 1 request per second per key; keys rotate with per-key cooldown on 429

# CrossRef API Configuration
CROSSREF_EMAIL=your_email@example.com
# No API key needed - email enables "polite pool" for better reliability
# Rate limit: 50 req/sec (we use 10 req/sec to be safe)

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                       # optional, for Qdrant Cloud
# After running migrate-collection, update to: lexicon_arxiv_v2
QDRANT_COLLECTION=lexicon_arxiv

# Gemini API Configuration (for LLM keyword extraction & abstract labeling)
GEMINI_API_KEYS=your_gemini_api_key_here
# Comma-separated for round-robin rotation: GEMINI_API_KEYS=key1,key2,key3
# Get your API key at: https://aistudio.google.com/app/apikey

# Embedding Model (Qwen3-Embedding-8B via Ollama)
# Install: ollama pull qwen3-embedding:8b
# Used by: embed-papers command and search API for query embedding

# Ollama Configuration (for local LLM keyword extraction)
OLLAMA_BASE_URL=http://localhost:11434
# Default model: llama3.1:8b — install with: ollama pull llama3.1:8b

# Reranker Model (Qwen3-Reranker-0.6B, auto-downloaded on first use)
# Used by the advanced retrieval pipeline for cross-encoder reranking.
# No manual download needed; the model is fetched automatically via HuggingFace.

# GitHub API Configuration (for code repository enrichment)
GITHUB_TOKEN=your_github_token_here
# Get a personal access token at: https://github.com/settings/tokens
# No special scopes needed (public repo access only)
# Rate limit: 30 search req/min with token, 10/min without
