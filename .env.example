# OpenAlex API Configuration
OPENALEX_API_KEYS=your_api_key_here
OPENALEX_EMAIL=your_email@example.com

# Get your free API key at: https://openalex.org/users
# Daily credit limit depends on your plan
# Note: from_updated_date (incremental collection) requires a Premium plan.
# Without Premium, the system falls back to publication_year filtering.

# Semantic Scholar API (comma-separated for multi-key round-robin rotation)
# Replaces the legacy S2_API_KEY (singular, still supported as fallback)
S2_API_KEYS=your_s2_key_1,your_s2_key_2
# Get your free API key at: https://www.semanticscholar.org/product/api#api-key
# Rate limit: 1 request per second per key; keys rotate with per-key cooldown on 429

# CrossRef API Configuration
CROSSREF_EMAIL=your_email@example.com
# No API key needed - email enables "polite pool" for better reliability
# Rate limit: 50 req/sec (we use 10 req/sec to be safe)

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                       # optional, for Qdrant Cloud
QDRANT_COLLECTION=lexicon_arxiv_v3    # production collection
QDRANT_TIMEOUT=300                    # HTTP client timeout in seconds; default is
                                      # generous (5 min) for bulk catchup — see
                                      # docs/runbooks/post-bootstrap-catchup.md.
                                      # Search / MCP callsites have their own 5 s
                                      # handler budget on top, so this ceiling is
                                      # harmless there.

# Ollama Configuration (local embedding + search-time chat; Path B 2026-07-04)
# All PIPELINE chat / labeling moved to vLLM — see
# docs/design/vllm-labeling-migration.md and docs/runbooks/vllm-labeling.md.
# Ollama continues to serve:
#   1. corpus embedding (bulk + incremental drain via embed-papers)
#   2. search-time query embedding (SearchService)
#   3. search-time HyDE (query_analyzer, opt-in via RetrievalConfig)
OLLAMA_BASE_URL=http://localhost:11434
# Embedding model: ollama pull qwen3-embedding:8b   (used by embed-papers + search API)
# Labeling LLM:    ollama pull granite4.1:8b         (dev fallback only)
# Keyword LLM:     ollama pull llama3.1:8b           (--llm/--judge flags — deprecated at bulk scale)

# vLLM Configuration (production labeling backend, containerized)
# See docs/runbooks/vllm-labeling.md for the sparkq + Docker launch procedure.
# VLLM_MODEL=ibm-granite/granite-4.1-8b
# VLLM_PORT=8000
# VLLM_GPU_MEM_UTIL=0.30                # ~38 G on 128 G GB10 unified pool
# VLLM_MAX_MODEL_LEN=4096
# VLLM_IMAGE=nvcr.io/nvidia/vllm:25.11-py3   # NGC arm64 build for DGX Spark

# Snapshot Enrichment (quarterly OpenAlex snapshot bootstrap + daily API delta)
# Download the snapshot to local SSD, then set:
# SNAPSHOT_DIR=/path/to/openalex_snapshot/data/works
DAGSTER_HOME=                          # default $HOME/dagster_home; holds per-phase checkpoints + embedding queue
# See docs/runbooks/snapshot-bootstrap.md for the Day 0..11+ procedure

# Reranker Model (Qwen3-Reranker-0.6B via sentence-transformers, auto-downloaded)
# Used by the advanced retrieval pipeline for cross-encoder reranking.
# No manual download needed; the model is fetched automatically via HuggingFace.

# ACM PDF Downloads (stealth browser via Crawl4AI/Playwright)
# No env vars needed. Chromium is installed via: uv run crawl4ai-setup
# ACM DOIs (10.1145/*) are automatically routed through the browser.
# CPU-only rendering (--disable-gpu); no GPU memory consumed.

# GitHub API Configuration (for code repository enrichment)
GITHUB_TOKEN=your_github_token_here
# Get a personal access token at: https://github.com/settings/tokens
# No special scopes needed (public repo access only)
# Rate limit: 30 search req/min with token, 10/min without
